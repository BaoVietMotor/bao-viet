# Header rules for files Cloudflare serves directly (without running the Worker).
# Images, CSS and JS skip the Worker (see run_worker_first in wrangler.jsonc), which keeps
# page views well inside the free plan. CSS/JS URLs carry ?v=<hash>, so they can be cached for a year.
/img/*
  Cache-Control: public, max-age=604800
  X-Content-Type-Options: nosniff

/css/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/js/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
